{
  "name": "canvas",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @canvas/editor --filter @canvas/agent-server dev",
    "build": "pnpm --filter @canvas/editor build",
    "preview": "pnpm --filter @canvas/editor preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
